{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["playwright.config.ts", "src/**/*.spec.ts"],
  "references": [
    { "path": "../contract/tsconfig.lib.json" },
    { "path": "../localsink/tsconfig.lib.json" }
  ]
}
