{
  "name": "localsink",
  "version": "0.0.0",
  "description": "Local-first log sink with a searchable UI and API.",
  "keywords": [
    "developer-tools",
    "fts5",
    "local-first",
    "log-aggregator",
    "log-sink",
    "logging",
    "logs",
    "mcp",
    "observability",
    "sqlite"
  ],
  "homepage": "https://github.com/localsink/localsink/tree/main/packages/localsink#readme",
  "bugs": "https://github.com/localsink/localsink/issues",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "localsink, LLC <hello@localsink.io> (https://localsink.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localsink/localsink.git",
    "directory": "packages/localsink"
  },
  "bin": {
    "localsink": "./src/cli.ts"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@localsink/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "localsink": "./dist/cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b .",
    "lint": "oxlint .",
    "test": "vitest run",
    "dev": "node --conditions=@localsink/source --watch --watch-path=src src/cli.ts",
    "start": "node --conditions=@localsink/source src/cli.ts",
    "seed": "node --conditions=@localsink/source src/seed.ts",
    "emit": "node --conditions=@localsink/source src/emit.ts",
    "drizzle-kit:push": "drizzle-kit push",
    "drizzle-kit:generate": "drizzle-kit generate",
    "drizzle-kit:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/mcp": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@libsql/client": "catalog:",
    "@localsink/contract": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@localsink/sdk": "workspace:*",
    "@localsink/web": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
